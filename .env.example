# Required for encrypted vault (32+ chars recommended)
AUTO_MCP_MASTER_KEY=change-me-to-a-long-random-secret

# Required for HTTP control-plane /api/* (except /api/health)
# Dashboard Vite proxy injects this automatically when set in repo .env
AUTO_MCP_CONTROL_TOKEN=change-me-to-a-random-api-token

# Local POC only: skip control token + allow weak master key / non-loopback bind
# AUTO_MCP_ALLOW_INSECURE_DEV=1

# Optional: override Cursor mcp.json path (default ~/.cursor/mcp.json)
# CURSOR_MCP_PATH=

# Optional: Chat explore / AI propose in dashboard (from https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=

# Control plane
PORT=3847
# Relative path is resolved from repo root (not process cwd)
DATA_DIR=.data
HOST=127.0.0.1
